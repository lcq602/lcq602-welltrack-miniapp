/* ==========================================================================
   Stitch "Serene Balance" Floating Bottom Navigation Dock
   ========================================================================== */

.tab-wrapper {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  pointer-events: none;
  display: flex;
  justify-content: center;
  padding: 0 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.tab-dock {
  pointer-events: auto;
  width: 100%;
  max-width: 700rpx;
  height: 124rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(28px) saturate(180%);
  -webkit-backdrop-filter: blur(28px) saturate(180%);
  border: 1.5rpx solid rgba(226, 232, 240, 0.85);
  border-radius: 9999rpx;
  box-shadow: 0 16rpx 44rpx -6rpx rgba(15, 23, 42, 0.09), 0 4rpx 14rpx rgba(15, 23, 42, 0.03);
  padding: 0 12rpx;
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  min-width: 0;
  cursor: pointer;
  transition: transform 0.15s ease;
}

.tab-item:active {
  transform: scale(0.93);
}

.tab-icon-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 48rpx;
  border-radius: 9999rpx;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-icon-pill-active {
  background: rgba(5, 150, 105, 0.12);
  width: 76rpx;
  height: 50rpx;
}

.tab-icon-img {
  width: 38rpx;
  height: 38rpx;
  display: block;
}

.tab-label {
  font-size: 20rpx;
  font-weight: 500;
  color: #64748b;
  margin-top: 4rpx;
  line-height: 1.1;
  transition: color 0.2s ease;
}

.tab-label-active {
  color: #059669;
  font-weight: 700;
}
