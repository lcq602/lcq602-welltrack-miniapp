/* ==========================================================================
   WellTrack 我的中心样式 (Stitch "Serene Balance" 个人空间)
   ========================================================================== */

/* 个人中心 Hero 卡片 */
.profile-hero-card {
  background: linear-gradient(135deg, #ffffff 0%, #f6fdfa 100%);
  border: 1.5rpx solid rgba(5, 150, 105, 0.16);
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
}

.avatar-squircle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #059669 0%, #006948 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 8rpx 24rpx rgba(5, 150, 105, 0.28);
  flex-shrink: 0;
}

.avatar-letter {
  font-size: 46rpx;
  font-weight: 850;
  color: #ffffff;
}

.avatar-status-dot {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #10b981;
  border: 3rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #ffffff;
  font-weight: 800;
}

.profile-meta {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 750;
  color: #0f172a;
}

.profile-desc {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.45;
  margin-top: 6rpx;
}

/* 基础体征与目标卡片 */
.baseline-card {
  padding: 36rpx 32rpx;
}

.baseline-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 12rpx;
}

.baseline-tile {
  background: #f8fafc;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.b-tile-label {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 600;
}

.b-tile-val {
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
  margin-top: 6rpx;
  line-height: 1.1;
}

.b-tile-unit {
  font-size: 22rpx;
  font-weight: 500;
  color: #94a3b8;
  margin-left: 4rpx;
}

.b-tile-date {
  font-size: 28rpx;
  font-weight: 700;
  color: #334155;
  margin-top: 10rpx;
}

.mi-source-note {
  font-size: 22rpx;
  color: #059669;
  background: #ecfdf5;
  border: 1rpx solid rgba(5, 150, 105, 0.18);
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  margin-top: 18rpx;
  line-height: 1.45;
}

.baseline-link-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f8fafc;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #334155;
  margin-top: 24rpx;
  transition: all 0.15s ease;
}

.baseline-link-btn:active {
  background: #f1f5f9;
}

.arrow-right {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 小米运动健康卡片 */
.mihealth-card {
  padding: 36rpx 32rpx;
}

.mi-metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.mi-metric-card {
  background: #f8fafc;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.mi-metric-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.mi-metric-title {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 600;
}

.mi-metric-date {
  font-size: 18rpx;
  color: #94a3b8;
}

.mi-metric-val {
  font-size: 38rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.1;
}

.mi-btn-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mi-sync-btn {
  width: 100%;
}

.mi-unbind-btn {
  width: 100%;
  border-color: #e2e8f0;
  color: #64748b;
}

.mi-form-intro {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 20rpx;
  background: #f8fafc;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid #eef2f6;
}

.mi-code-box {
  background: #f8fafc;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 24rpx;
  padding: 24rpx;
}
