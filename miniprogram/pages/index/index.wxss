/* ==========================================================================
   WellTrack 首页样式 (Stitch "Serene Balance" 仪表盘)
   ========================================================================== */

/* 顶部状态栏与胶囊 */
.head-copy {
  display: flex;
  flex-direction: column;
}

.today-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(16px);
  border: 1rpx solid rgba(226, 232, 240, 0.85);
  border-radius: 9999rpx;
  padding: 10rpx 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.04);
}

.today-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #334155;
}

.today-badge {
  font-size: 18rpx;
  font-weight: 700;
  color: #059669;
  background: #ecfdf5;
  padding: 2rpx 10rpx;
  border-radius: 9999rpx;
}

/* 首次引导面板 */
.setup-panel {
  background: linear-gradient(180deg, #ffffff 0%, #f7fdfa 100%);
  border: 1.5rpx solid rgba(5, 150, 105, 0.15);
  padding: 40rpx 32rpx;
}

.setup-hero {
  text-align: center;
  margin-bottom: 36rpx;
}

.setup-step {
  font-size: 20rpx;
  font-weight: 700;
  color: #059669;
  letter-spacing: 2rpx;
}

.setup-heading {
  font-size: 38rpx;
  font-weight: 800;
  color: #0f172a;
  margin: 10rpx 0 8rpx;
}

.setup-copy {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.control-box {
  position: relative;
  width: 100%;
}

.input-unit {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 26rpx;
  color: #94a3b8;
  font-weight: 600;
}

.setup-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.setup-submit {
  margin-top: 36rpx;
}

/* 2. Hero 中心健康聚焦卡片 */
.hero-card {
  background: linear-gradient(180deg, #ffffff 0%, #f6fdf9 100%);
  border: 1.5rpx solid rgba(5, 150, 105, 0.14);
  box-shadow: 0 16rpx 40rpx -8rpx rgba(5, 150, 105, 0.08), 0 2rpx 8rpx rgba(15, 23, 42, 0.02);
  padding: 36rpx 32rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-status {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.hero-goal-pill {
  gap: 6rpx;
}

.pill-spark {
  font-size: 18rpx;
  color: #059669;
}

.hero-target-hint {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}

.remaining-tag {
  color: #059669;
  font-weight: 650;
}

.hero-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 0 18rpx;
}

.hero-weight-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.hero-weight-num {
  font-size: 72rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -2rpx;
  line-height: 1;
}

.hero-weight-unit {
  font-size: 28rpx;
  font-weight: 600;
  color: #64748b;
}

.hero-diff-pill {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 650;
  color: #059669;
  background: #ecfdf5;
  border: 1rpx solid rgba(5, 150, 105, 0.2);
  padding: 4rpx 14rpx;
  border-radius: 9999rpx;
  margin-left: 12rpx;
}

.hero-subtext {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 10rpx;
}

.hero-gauge {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #f0fdf4;
  border: 6rpx solid #10b981;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(16, 185, 129, 0.2);
}

.gauge-percent {
  font-size: 26rpx;
  font-weight: 800;
  color: #059669;
  line-height: 1;
}

.gauge-label {
  font-size: 18rpx;
  font-weight: 500;
  color: #64748b;
  margin-top: 4rpx;
  line-height: 1;
}

.hero-progress-track {
  height: 12rpx;
  background: #f1f5f9;
  border-radius: 9999rpx;
  overflow: hidden;
  margin-top: 16rpx;
}

.hero-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #10b981 0%, #059669 100%);
  border-radius: 9999rpx;
  transition: width 0.4s ease;
}

.hero-foot-row {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #64748b;
  margin-top: 12rpx;
}

.hero-foot-value {
  font-weight: 650;
  color: #0f172a;
}

/* 3. Metric Bento Grid */
.bento-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.bento-tile {
  margin-bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 28rpx;
}

.bento-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bento-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #64748b;
}

.streak-flame {
  font-size: 26rpx;
}

.bento-body {
  margin: 14rpx 0 8rpx;
}

.bento-value {
  font-size: 48rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -1rpx;
  line-height: 1.1;
}

.unit-sub {
  font-size: 22rpx;
  font-weight: 500;
  color: #94a3b8;
  margin-left: 6rpx;
}

.bento-hint {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
  display: block;
}

.bmi-spectrum-bar {
  display: flex;
  height: 10rpx;
  border-radius: 9999rpx;
  overflow: hidden;
  margin-top: 14rpx;
}

.spec-blue { flex: 1; background: #93c5fd; }
.spec-green { flex: 2; background: #34d399; }
.spec-amber { flex: 1; background: #fcd34d; }

.bmi-spectrum-labels {
  display: flex;
  justify-content: space-between;
  font-size: 18rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.active-dot {
  color: #059669;
  font-weight: 700;
}

.streak-dots {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.dot-item {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  font-weight: 700;
}

.dot-recorded {
  background: #059669;
  color: #ffffff;
}

.dot-empty {
  border: 2rpx dashed #cbd5e1;
  background: transparent;
}

.dot-today {
  box-shadow: 0 0 0 4rpx rgba(5, 150, 105, 0.25);
}

.bento-wide {
  grid-column: span 2;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.activity-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.activity-icon-box {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #eff6ff;
  border: 1rpx solid rgba(37, 99, 235, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.activity-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.activity-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.activity-desc {
  font-size: 24rpx;
  font-weight: 600;
  color: #334155;
  margin-top: 4rpx;
}

.activity-meta {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 2rpx;
}

.activity-badge {
  text-align: right;
}

.activity-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #2563eb;
  line-height: 1;
}

.activity-unit {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 500;
  margin-left: 4rpx;
}

/* 4. 今日行动清单 */
.action-card {
  padding: 32rpx;
}

.action-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.action-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 1rpx solid #eef2f6;
  box-sizing: border-box;
}

.action-item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #059669;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
}

.action-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
}

.action-item-status {
  font-size: 22rpx;
  color: #94a3b8;
}

/* 3.5 小米运动健康 · 今日活力看板 */
.vitality-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border: 1.5rpx solid rgba(226, 232, 240, 0.85);
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.03);
}

.vitality-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.vitality-title-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.vitality-badge-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #94a3b8;
  flex-shrink: 0;
}

.vitality-badge-dot.dot-active {
  background: #059669;
  box-shadow: 0 0 0 6rpx rgba(5, 150, 105, 0.2);
}

.vitality-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: -0.3rpx;
}

.vitality-action-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 22rpx;
  border-radius: 9999rpx;
  background: #f1f5f9;
  color: #334155;
  font-size: 22rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.vitality-action-btn:active {
  background: #e2e8f0;
  transform: scale(0.96);
}

.vitality-sync-icon {
  font-size: 22rpx;
  line-height: 1;
}

.spinning {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  100% { transform: rotate(360deg); }
}

.vitality-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.vitality-tile {
  border-radius: 20rpx;
  padding: 22rpx 20rpx;
  border: 1rpx solid #eef2f6;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
}

.tile-steps {
  background: linear-gradient(135deg, #f0fdf4 0%, #f8fafc 100%);
  border-color: rgba(5, 150, 105, 0.15);
}

.tile-cals {
  background: linear-gradient(135deg, #fffbeb 0%, #f8fafc 100%);
  border-color: rgba(217, 119, 6, 0.15);
}

.tile-sleep {
  background: linear-gradient(135deg, #faf5ff 0%, #f8fafc 100%);
  border-color: rgba(147, 51, 234, 0.15);
}

.tile-active {
  background: linear-gradient(135deg, #eff6ff 0%, #f8fafc 100%);
  border-color: rgba(37, 99, 235, 0.15);
}

.v-tile-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.v-tile-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #64748b;
}

.v-tile-icon {
  font-size: 24rpx;
  line-height: 1;
}

.v-tile-val-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-bottom: 10rpx;
}

.v-tile-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1;
  font-feature-settings: "tnum";
}

.v-tile-unit {
  font-size: 20rpx;
  color: #64748b;
  font-weight: 550;
}

.v-progress-track {
  height: 8rpx;
  background: #e2e8f0;
  border-radius: 9999rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.v-progress-fill {
  height: 100%;
  border-radius: 9999rpx;
  transition: width 0.3s ease;
}

.fill-emerald {
  background: #059669;
}

.fill-amber {
  background: #d97706;
}

.v-tile-foot {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: 500;
}

.status-good {
  color: #059669 !important;
  font-weight: 600;
}

.vitality-connect-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 16rpx 22rpx;
  background: #eff6ff;
  border-radius: 16rpx;
  border: 1rpx solid rgba(37, 99, 235, 0.15);
  font-size: 22rpx;
  color: #1e40af;
}

.hint-icon {
  margin-right: 8rpx;
}

.hint-text {
  flex: 1;
}

.hint-arrow {
  font-weight: 700;
  color: #2563eb;
}

.action-btn-row {
  margin-top: 28rpx;
  width: 100%;
}

.action-btn-main, .action-btn-sub {
  height: 88rpx !important;
  min-height: 88rpx !important;
  line-height: 88rpx !important;
  font-size: 28rpx !important;
  font-weight: 650 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 12rpx !important;
  border-radius: 9999rpx !important;
  padding: 0 24rpx !important;
  box-sizing: border-box !important;
}

.btn-icon {
  font-size: 26rpx;
  line-height: 1;
}

/* 5. 7天体重波动图 */
.trend-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.trend-header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.trend-link {
  font-size: 24rpx;
  font-weight: 650;
  color: #059669;
}

.trend-chart-box {
  position: relative;
  padding-top: 40rpx;
}

.trend-baseline-line {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 80rpx;
  border-bottom: 1.5rpx dashed #e2e8f0;
  z-index: 1;
}

.trend-bar-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  align-items: flex-end;
  height: 260rpx;
  position: relative;
  z-index: 2;
  gap: 8rpx;
}

.trend-bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.bar-weight-tag {
  font-size: 18rpx;
  color: #64748b;
  text-align: center;
  margin-bottom: 8rpx;
  border-radius: 9999rpx;
  padding: 2rpx 8rpx;
  background: #f1f5f9;
}

.tag-today {
  background: #059669;
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 4rpx 10rpx rgba(5, 150, 105, 0.25);
}

.trend-bar-track {
  width: 28rpx;
  height: 170rpx;
  background: #f1f5f9;
  border-radius: 9999rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  overflow: hidden;
  padding: 2rpx;
  box-sizing: border-box;
}

.trend-bar-pill {
  width: 100%;
  border-radius: 9999rpx;
  transition: height 0.3s ease;
}

.bar-filled {
  background: #cbd5e1;
}

.bar-empty {
  background: #e2e8f0;
}

.bar-today {
  background: linear-gradient(180deg, #10b981 0%, #059669 100%) !important;
  box-shadow: 0 4rpx 12rpx rgba(5, 150, 105, 0.3);
}

.trend-weekday {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 12rpx;
}

.weekday-today {
  color: #059669;
  font-weight: 750;
}

/* 6. 横向探索卡片 */
.journey-section {
  margin: 16rpx 0 24rpx;
}

.journey-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.journey-heading {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.journey-hint {
  font-size: 22rpx;
  color: #94a3b8;
}

.journey-scroll {
  width: 100%;
  white-space: nowrap;
}

.journey-track {
  display: flex;
  gap: 20rpx;
  padding-bottom: 8rpx;
}

.journey-card {
  flex: 0 0 360rpx;
  padding: 30rpx 28rpx;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 260rpx;
  white-space: normal;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx -4rpx rgba(15, 23, 42, 0.04);
}

.card-j-emerald {
  background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%);
  border: 1.5rpx solid rgba(5, 150, 105, 0.18);
}

.card-j-blue {
  background: linear-gradient(135deg, #eff6ff 0%, #ffffff 100%);
  border: 1.5rpx solid rgba(37, 99, 235, 0.18);
}

.card-j-purple {
  background: linear-gradient(135deg, #f5f3ff 0%, #ffffff 100%);
  border: 1.5rpx solid rgba(124, 58, 237, 0.18);
}

.j-icon-squircle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.05);
}

.j-body {
  margin: 18rpx 0 14rpx;
}

.j-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.j-desc {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.45;
  margin-top: 6rpx;
}

.j-link {
  font-size: 22rpx;
  font-weight: 650;
  color: #059669;
}

.card-j-blue .j-link {
  color: #2563eb;
}

.card-j-purple .j-link {
  color: #7c3aed;
}

.health-disclaimer {
  padding: 0 16rpx;
}
