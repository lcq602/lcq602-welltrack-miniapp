.page-head { align-items: flex-start; }
.page-head .title { max-width: 510rpx; font-size: 42rpx; }
.today-mark { text-align: center; color: #748099; font-size: 19rpx; line-height: 1.5; padding: 10rpx 15rpx; border: 1rpx solid #dfe5f0; border-radius: 15rpx; }
.today-mark text { color: #2848d8; font-size: 25rpx; font-weight: 700; }
.hero-card { color: #ffffff; border-radius: 32rpx; padding: 34rpx; background: linear-gradient(135deg, #141e35 0%, #1d2c50 68%, #315bff 145%); box-shadow: 0 18rpx 38rpx rgba(31, 62, 157, .2); }
.hero-top,.hero-bottom { display: flex; align-items: center; justify-content: space-between; }
.hero-label,.hero-caption { color: rgba(255,253,245,.68); font-size: 22rpx; }
.hero-tag { color: #d7fb58; background: rgba(255,255,255,.1); padding: 9rpx 18rpx; border-radius: 99rpx; font-size: 21rpx; }
.hero-caption { display: block; margin-top: 30rpx; }
.hero-weight { font-size: 88rpx; line-height: 1.1; letter-spacing: -3rpx; font-weight: 750; margin: 3rpx 0 24rpx; }
.hero-weight text { font-size: 27rpx; letter-spacing: 0; color: #cbd5e8; }
.hero-target { display: block; color: #ffffff; font-size: 29rpx; font-weight: 650; margin-top: 5rpx; }
.hero-progress-label { color: #d7fb58; font-size: 22rpx; }
.hero-foot { color: rgba(255,253,245,.6); font-size: 20rpx; margin-top: 14rpx; }
.metric-row { display: flex; gap: 18rpx; margin: 20rpx 0 34rpx; }
.metric-card { flex: 1; background: #ffffff; border: 1rpx solid #e3e8f2; border-radius: 24rpx; padding: 22rpx; min-height: 175rpx; }
.metric-icon { width: 48rpx; height: 48rpx; border-radius: 15rpx; display: flex; align-items: center; justify-content: center; font-size: 17rpx; font-weight: 750; }
.bmi-icon { color: #2848d8; background: #eaf0ff; }
.week-icon { color: #315bff; background: #eaf0ff; }
.metric-number { font-size: 44rpx; font-weight: 750; margin-top: 10rpx; color: #26344e; }
.metric-unit { font-size: 24rpx; color: #748099; font-weight: 500; }
.metric-label { color: #64718a; font-size: 21rpx; }
.metric-hint { color: #748099; font-size: 18rpx; margin-top: 5rpx; }
.section-heading { display: flex; justify-content: space-between; align-items: center; margin: 30rpx 2rpx 16rpx; }
.section-heading .section-title { margin: 0 0 4rpx; }
.section-count { color: #748099; font-size: 21rpx; }
.todo-card,.trend-card { background: #ffffff; border: 1rpx solid #e3e8f2; border-radius: 26rpx; padding: 22rpx 26rpx; }
.todo-item { min-height: 68rpx; display: flex; align-items: center; color: #5e6b85; font-size: 24rpx; border-bottom: 1rpx solid #edf1f8; }
.todo-dot { width: 13rpx; height: 13rpx; border: 2rpx solid #a9b4c8; border-radius: 50%; margin-right: 16rpx; }
.action-pair { display: flex; gap: 14rpx; margin-top: 18rpx; }
.action-button { flex: 1; border-radius: 16rpx; font-size: 22rpx; line-height: 76rpx; height: 76rpx; margin: 0; padding: 0 8rpx; }
.action-button::after { border: 0; }
.action-primary { color: white; background: #315bff; }
.action-secondary { color: #315bff; background: #eaf0ff; }
.trend-summary { display: flex; align-items: baseline; justify-content: space-between; }
.trend-latest { color: #26344e; font-size: 39rpx; font-weight: 750; }
.trend-latest text { font-size: 21rpx; font-weight: 500; color: #748099; }
.trend-bars { display: flex; justify-content: space-around; align-items: flex-end; height: 190rpx; padding-top: 10rpx; }
.trend-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.trend-value { height: 30rpx; color: #748099; font-size: 17rpx; }
.trend-track { width: 24rpx; height: 112rpx; display: flex; align-items: flex-end; background: #edf1f8; border-radius: 99rpx; overflow: hidden; }
.trend-bar { width: 100%; background: #315bff; border-radius: 99rpx; }
.trend-bar-empty { background: #dfe5f0; }
.trend-date { margin-top: 10rpx; color: #748099; font-size: 17rpx; }
.empty-mark { font-size: 40rpx; color: #315bff; margin-bottom: 8rpx; }
.health-note { color: #748099; text-align: center; font-size: 19rpx; line-height: 1.7; padding: 18rpx 10rpx 0; }
.setup-panel { background: #ffffff; border: 1rpx solid #e3e8f2; border-radius: 30rpx; padding: 30rpx; }
.setup-number { color: #315bff; letter-spacing: 2rpx; font-size: 20rpx; font-weight: 700; }
.setup-heading { font-size: 35rpx; font-weight: 750; margin-top: 12rpx; }
.setup-copy { color: #748099; font-size: 23rpx; line-height: 1.7; margin: 8rpx 0 24rpx; }
.setup-grid { display: flex; gap: 16rpx; }
.setup-grid > view { flex: 1; min-width: 0; }
.picker-field { display: flex; align-items: center; justify-content: space-between; color: #465574; }
.loading-state { padding: 180rpx 0; color: #748099; text-align: center; font-size: 23rpx; }
.loading-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #315bff; margin: 0 auto 20rpx; }
.error-state { margin: 170rpx 28rpx 0; padding: 32rpx; text-align: center; background: #ffffff; border-radius: 24rpx; border: 1rpx solid #e3e8f2; }
.error-mark { width: 52rpx; height: 52rpx; margin: 0 auto 16rpx; border-radius: 50%; background: #eaf0ff; color: #315bff; font-size: 31rpx; line-height: 52rpx; font-weight: 700; }
.weight-source-note { margin-top: 8rpx; color: rgba(255,255,255,.72); font-size: 19rpx; letter-spacing: .02em; }
