<view class="page"><view class="eyebrow">MOVE AT YOUR PACE</view><view class="title">运动计划</view><view class="card"><view class="section-title">安排运动</view><picker mode="date" value="{{exercise_date}}" bindchange="onInput" data-key="exercise_date"><view class="input">日期：{{exercise_date}}</view></picker><picker range="{{['有氧','力量训练','步行','拉伸','休息']}}" bindchange="onKind"><view class="input">运动类型：{{kind}}</view></picker><input class="input" type="number" placeholder="时长（分钟）" data-key="duration" bindinput="onInput"/><input class="input" placeholder="备注" data-key="note" bindinput="onInput"/><button class="button" bindtap="save">添加运动</button></view><view class="section-title">运动记录</view><view wx:for="{{items}}" wx:key="id" class="card"><view class="row"><text>{{item.kind}}</text><text class="pill">{{item.duration_minutes}} 分钟</text></view><view class="muted">{{item.exercise_date}} · {{item.note}}</view></view></view>
