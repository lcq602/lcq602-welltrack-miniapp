<view class="page"><view class="eyebrow">DAILY CHECK-IN</view><view class="title">日常记录</view>
  <view class="card"><view class="section-title">今天的状态</view><picker mode="date" value="{{form.record_date}}" bindchange="onInput" data-key="record_date"><view class="input">日期：{{form.record_date}}</view></picker><view class="grid"><input class="input" type="digit" placeholder="体重 kg" data-key="weight" bindinput="onInput"/><input class="input" type="digit" placeholder="腰围 cm" data-key="waist_cm" bindinput="onInput"/><input class="input" type="number" placeholder="饮水 ml" data-key="water_ml" bindinput="onInput"/><input class="input" type="digit" placeholder="睡眠 小时" data-key="sleep_hours" bindinput="onInput"/></view><input class="input" placeholder="饮食简记" data-key="diet" bindinput="onInput"/><view class="section-title">习惯</view><view class="row wrap"><text wx:for="{{habitItems}}" wx:key="name" class="pill {{item.selected ? 'pill-selected' : ''}}" data-item="{{item.name}}" bindtap="onHabit">{{item.selected ? '✓ ' : ''}}{{item.name}}</text></view><textarea class="input" placeholder="备注（选填）" data-key="note" bindinput="onInput"></textarea><button class="button" bindtap="save">保存记录</button><view class="muted">本版本采用新增式保存，同一日只接受一条记录。</view></view>
  <view class="section-title">历史记录</view><view wx:for="{{records}}" wx:key="id" class="card"><view class="row"><text>{{item.record_date}}</text><text class="value small">{{item.weight || '--'}} kg</text></view><view class="muted">腰围 {{item.waist_cm || '--'}} cm · 饮水 {{item.water_ml || '--'}} ml · 睡眠 {{item.sleep_hours || '--'}} h</view><view class="muted">{{item.habit_text}}</view></view>
</view>
