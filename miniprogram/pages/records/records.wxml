<view class="page">
  <view class="eyebrow">A GENTLE DAILY CHECK-IN</view><view class="title">记录今天</view>
  <view class="export-actions"><text>个人数据</text><button class="export-button" bindtap="exportCsv">导出 CSV</button><button class="export-button" bindtap="exportBackup">JSON 备份</button></view>
  <view class="record-date"><view><view class="record-date-label">正在记录</view><view class="record-date-title">{{form.record_date}}</view></view><picker mode="date" value="{{form.record_date}}" bindchange="onInput" data-key="record_date"><view class="date-change">更改日期　⌄</view></picker></view>
  <view class="card">
    <view class="form-section"><view class="section-index">01</view><view class="section-title">身体数据</view></view><view class="muted section-note">不必每天都称重，记录你方便观察的项目。</view>
    <view class="input-grid"><view><text class="field-label">体重 · kg</text><input class="input" type="digit" value="{{form.weight}}" placeholder="—" data-key="weight" bindinput="onInput" /></view><view><text class="field-label">腰围 · cm</text><input class="input" type="digit" value="{{form.waist_cm}}" placeholder="—" data-key="waist_cm" bindinput="onInput" /></view></view>
    <view class="form-section section-spaced"><view class="section-index">02</view><view class="section-title">日常状态</view></view>
    <view class="input-grid"><view><text class="field-label">饮水 · ml</text><input class="input" type="number" value="{{form.water_ml}}" placeholder="例如 1600" data-key="water_ml" bindinput="onInput" /></view><view><text class="field-label">睡眠 · 小时</text><input class="input" type="digit" value="{{form.sleep_hours}}" placeholder="例如 7.5" data-key="sleep_hours" bindinput="onInput" /></view></view>
    <text class="field-label">饮食简记</text><input class="input" value="{{form.diet}}" placeholder="例如：三餐规律，晚餐有蔬菜" data-key="diet" bindinput="onInput" />
    <view class="form-section section-spaced"><view class="section-index">03</view><view class="section-title">今天做到的小习惯</view></view>
    <view class="habit-grid"><view wx:for="{{habitItems}}" wx:key="name" class="habit-chip {{item.selected ? 'habit-selected' : ''}}" data-item="{{item.name}}" bindtap="onHabit"><view class="habit-check">{{item.selected ? '✓' : '+'}}</view><text>{{item.name}}</text></view></view>
    <text class="field-label">补充备注 · 选填</text><textarea class="input note-input" value="{{form.note}}" placeholder="写下今天值得记住的一件事…" data-key="note" bindinput="onInput"></textarea>
    <view wx:if="{{alreadySaved}}" class="saved-notice">✓ 这一天已经有记录，请在上方选择其他日期。</view><button class="button save-button" loading="{{saving}}" disabled="{{loading || saving || alreadySaved}}" bindtap="save">{{saving ? '正在保存…' : loading ? '正在检查记录…' : alreadySaved ? '当天记录已保存' : '保存今天的记录'}}</button>
    <view class="append-note">每个日期仅新增一条记录；已有记录可在下方查看。</view>
  </view>
  <view class="history-head"><view><view class="section-title">最近记录</view><view class="muted">共展示最近 {{records.length}} 条</view></view><text class="history-icon">↘</text></view>
  <view wx:if="{{records.length}}">
    <view wx:for="{{records}}" wx:key="id" class="history-card"><view class="history-top"><view><view class="history-date">{{item.record_date}}</view><view class="history-habits">{{item.habit_text || '习惯未勾选'}}</view></view><view class="history-weight">{{item.weight || '—'}}<text> kg</text></view></view><view class="history-metrics"><text>腰围 {{item.waist_cm || '—'}} cm</text><text>饮水 {{item.water_ml || '—'}} ml</text><text>睡眠 {{item.sleep_hours || '—'}} h</text></view><view wx:if="{{item.diet}}" class="history-diet">{{item.diet}}</view></view>
  </view><view wx:elif="{{loading && !hasLoaded}}" class="history-card initial-fetch"><view class="loading-orbit"><view class="loading-spark"></view></view><view class="loading-copy">正在整理最近记录</view></view><view wx:else class="empty history-card">还没有记录。填下今天的一项数据，就能开始观察自己的变化。</view>
</view>
