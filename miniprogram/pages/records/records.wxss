/* ==========================================================================
   WellTrack 记录页面样式 (Stitch "Serene Balance" 每日健康记录)
   ========================================================================== */

/* 顶部导出胶囊组 */
.export-pill-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.export-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(16px);
  border: 1.5rpx solid rgba(226, 232, 240, 0.85);
  border-radius: 9999rpx;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #334155;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.03);
  transition: all 0.15s ease;
}

.export-pill:active {
  transform: scale(0.96);
  background: #f8fafc;
}

.export-icon {
  font-size: 22rpx;
}

/* 正在记录日期横幅 */
.record-date-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
}

.date-card-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.date-icon-box {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #eff6ff;
  border: 1rpx solid rgba(37, 99, 235, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.date-card-kicker {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: 600;
}

.date-card-val {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
}

.date-change-pill {
  gap: 6rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}

/* 主录入表单卡片 */
.form-main-card {
  padding: 36rpx 32rpx;
}

.form-sec-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.sec-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sec-badge-emerald {
  background: #ecfdf5;
  color: #059669;
  border: 1rpx solid rgba(5, 150, 105, 0.2);
}

.sec-badge-blue {
  background: #eff6ff;
  color: #2563eb;
  border: 1rpx solid rgba(37, 99, 235, 0.2);
}

.sec-badge-amber {
  background: #fef3c7;
  color: #d97706;
  border: 1rpx solid rgba(217, 119, 6, 0.2);
}

.sec-title {
  font-size: 28rpx;
  font-weight: 750;
  color: #0f172a;
}

.form-sec-gap {
  margin-top: 36rpx;
}

.input-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.record-input-tile {
  background: #f8fafc;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.tile-label {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 600;
}

.tile-control {
  position: relative;
  margin-top: 10rpx;
  display: flex;
  align-items: baseline;
}

.tile-num-input {
  background: transparent !important;
  border: none !important;
  font-size: 40rpx !important;
  font-weight: 800 !important;
  color: #0f172a !important;
  padding: 0 !important;
  min-height: 50rpx !important;
  height: 50rpx !important;
}

.tile-unit {
  position: absolute;
  right: 0;
  bottom: 6rpx;
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 600;
}

.form-field-wrap {
  margin-top: 18rpx;
}

/* 习惯多选胶囊 */
.habit-chips-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.habit-btn {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: #f8fafc;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 9999rpx;
  padding: 14rpx 26rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  transition: all 0.2s ease;
}

.habit-btn:active {
  transform: scale(0.96);
}

.habit-btn-active {
  background: #059669;
  border-color: #059669;
  color: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(5, 150, 105, 0.25);
  font-weight: 700;
}

.habit-check-mark {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #e2e8f0;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
}

.habit-btn-active .habit-check-mark {
  background: #ffffff;
  color: #059669;
}

.note-textarea {
  min-height: 120rpx;
  height: 120rpx;
  padding: 20rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
  font-size: 26rpx;
}

.already-notice {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ecfdf5;
  border: 1.5rpx solid rgba(5, 150, 105, 0.25);
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  font-size: 24rpx;
  color: #059669;
  font-weight: 650;
  margin-top: 24rpx;
}

.notice-icon {
  font-weight: 800;
}

.save-record-btn {
  margin-top: 30rpx;
  width: 100% !important;
}

.mi-hint-pill {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #f0fdf4;
  border: 1rpx solid rgba(5, 150, 105, 0.2);
  border-radius: 16rpx;
  padding: 16rpx 22rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #059669;
  margin-top: 20rpx;
}

.mi-hint-icon {
  font-size: 26rpx;
}

/* 4. 最近记录列表 */
.history-section {
  margin-top: 36rpx;
}

.history-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

/* 筛选分段胶囊组 */
.history-filter-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.filter-pill {
  padding: 10rpx 24rpx;
  border-radius: 9999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #64748b;
  background: #ffffff;
  border: 1.5rpx solid #e2e8f0;
  transition: all 0.2s ease;
}

.filter-pill:active {
  transform: scale(0.96);
}

.filter-active {
  background: #0f172a !important;
  color: #ffffff !important;
  border-color: #0f172a !important;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.15);
}

.history-card {
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
}

.history-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.history-date-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.history-date-badge {
  font-size: 30rpx;
  font-weight: 750;
  color: #0f172a;
}

.mi-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: #eff6ff;
  border: 1rpx solid rgba(37, 99, 235, 0.2);
  color: #2563eb;
  padding: 4rpx 14rpx;
  border-radius: 9999rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.mi-badge-icon {
  font-size: 20rpx;
  line-height: 1;
}

.history-habits-text {
  font-size: 22rpx;
  color: #059669;
  font-weight: 650;
  margin-top: 6rpx;
}

.history-weight-pill {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  background: #f0fdf4;
  border: 1rpx solid rgba(5, 150, 105, 0.2);
  padding: 6rpx 20rpx;
  border-radius: 9999rpx;
}

.h-weight-val {
  font-size: 36rpx;
  font-weight: 800;
  color: #059669;
}

.h-weight-unit {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 600;
}

.history-metrics-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.metric-mini-tag {
  background: #f8fafc;
  border: 1rpx solid #eef2f6;
  border-radius: 14rpx;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  display: inline-flex;
  gap: 8rpx;
  align-items: center;
}

.tag-steps {
  background: #f0fdf4;
  border-color: rgba(5, 150, 105, 0.18);
  color: #059669;
}

.tag-cals {
  background: #fffbeb;
  border-color: rgba(217, 119, 6, 0.18);
  color: #b45309;
}

.tag-sleep {
  background: #faf5ff;
  border-color: rgba(147, 51, 234, 0.18);
  color: #7e22ce;
}

.tag-workout {
  background: #eff6ff;
  border-color: rgba(37, 99, 235, 0.18);
  color: #1d4ed8;
}

.tag-name {
  color: #64748b;
}

.tag-val {
  font-weight: 650;
  color: #0f172a;
}

.history-diet-bubble {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  font-size: 22rpx;
  color: #475569;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.history-note-text {
  font-size: 22rpx;
  color: #64748b;
  font-style: italic;
  margin-top: 10rpx;
  line-height: 1.4;
}
