/* ==========================================================================
   WellTrack 计划页面样式 (Stitch "Serene Balance" 阶段计划)
   ========================================================================== */

/* 激励语录卡片 */
.plan-quote-card {
  background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%);
  border: 1.5rpx solid rgba(5, 150, 105, 0.18);
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  padding: 28rpx 30rpx;
}

.quote-spark {
  width: 52rpx;
  height: 52rpx;
  border-radius: 18rpx;
  background: #ecfdf5;
  color: #059669;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.quote-title {
  font-size: 28rpx;
  font-weight: 750;
  color: #0f172a;
}

.quote-desc {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.5;
  margin-top: 6rpx;
}

/* 目标卡片 */
.plan-target-card {
  padding: 36rpx 32rpx;
}

/* 管理方向分段标签 */
.goal-chips-row {
  display: flex;
  gap: 14rpx;
  margin: 14rpx 0 28rpx;
}

.goal-chip {
  flex: 1;
  height: 74rpx;
  border-radius: 9999rpx;
  background: #f8fafc;
  border: 1.5rpx solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  transition: all 0.2s ease;
}

.goal-chip:active {
  transform: scale(0.96);
}

.goal-chip-active {
  background: #059669;
  border-color: #059669;
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(5, 150, 105, 0.25);
  font-weight: 700;
}

/* 双数值输入网格 */
.plan-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.plan-input-tile {
  background: #f8fafc;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
}

.tile-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tile-label {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 600;
}

.tile-delta {
  font-size: 20rpx;
  font-weight: 700;
  color: #059669;
  background: #ecfdf5;
  padding: 2rpx 10rpx;
  border-radius: 9999rpx;
}

.tile-control {
  position: relative;
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
}

.tile-input {
  background: transparent !important;
  border: none !important;
  font-size: 42rpx !important;
  font-weight: 800 !important;
  color: #0f172a !important;
  padding: 0 !important;
  min-height: 52rpx !important;
  height: 52rpx !important;
}

.tile-unit {
  position: absolute;
  right: 0;
  bottom: 6rpx;
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 600;
}

/* 日期行 */
.plan-dates-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.date-picker-box {
  height: 84rpx;
}

.picker-value {
  font-size: 26rpx;
  color: #1e293b;
  font-weight: 600;
}

.picker-icon {
  font-size: 24rpx;
  color: #94a3b8;
}

.align-left {
  text-align: left;
}

/* 周日程安排 */
.schedule-card {
  padding: 36rpx 32rpx;
}

.schedule-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.schedule-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.day-badge {
  width: 84rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #eff6ff;
  border: 1rpx solid rgba(37, 99, 235, 0.15);
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.schedule-picker-wrap {
  flex: 1;
  min-width: 0;
}

.schedule-selector {
  background: #f8fafc;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 22rpx;
  height: 80rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.selector-content {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.selector-value {
  font-size: 26rpx;
  font-weight: 650;
  color: #0f172a;
}

.selector-tag {
  font-size: 18rpx;
  padding: 2rpx 12rpx;
}

.selector-arrow {
  font-size: 24rpx;
  color: #94a3b8;
}

.save-plan-btn {
  margin-top: 36rpx;
  width: 100% !important;
}
