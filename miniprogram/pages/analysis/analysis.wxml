<view class="page"><view class="eyebrow">YOUR INSIGHTS</view><view class="title">数据分析</view><view class="row"><text class="pill" data-period="week" bindtap="onPeriod">本周</text><text class="pill" data-period="month" bindtap="onPeriod">本月</text><text class="pill" data-period="calendar" bindtap="onPeriod">日历</text></view><view wx:if="{{summary}}"><view class="card"><view class="row"><view><view class="label">运动次数</view><view class="value">{{summary.exercise_count}}</view></view><view><view class="label">运动时长</view><view class="value">{{summary.exercise_minutes}}<text class="label"> 分钟</text></view></view><view><view class="label">平均睡眠</view><view class="value">{{summary.average_sleep || '--'}}<text class="label"> h</text></view></view></view><view class="line"></view><view class="label">习惯记录日完成率 {{summary.habit_completion}}%</view></view><view class="card"><view class="section-title">体重与腰围</view><view class="chart"><view wx:for="{{bars}}" wx:key="record_date" class="bar-wrap"><view class="bar" style="height: {{item.height}}rpx"></view><text class="muted">{{item.short_date}}</text><text class="tiny">{{item.weight || ''}}</text></view></view><view wx:for="{{summary.days}}" wx:key="record_date" class="row history"><text>{{item.record_date}}</text><text class="muted">体重 {{item.weight || '--'}} kg · 腰围 {{item.waist_cm || '--'}} cm</text></view></view><view class="muted">统计仅总结个人记录，不构成医疗建议。</view></view></view>
