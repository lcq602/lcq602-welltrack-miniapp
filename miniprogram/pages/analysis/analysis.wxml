<view class="page">
  <view class="eyebrow">SMALL STEPS, CLEARER PICTURE</view><view class="title">数据复盘</view>
  <view class="period-switch"><view class="period-option {{period === 'week' ? 'period-active' : ''}}" data-period="week" bindtap="onPeriod">本周</view><view class="period-option {{period === 'month' ? 'period-active' : ''}}" data-period="month" bindtap="onPeriod">本月</view><view class="period-option {{period === 'calendar' ? 'period-active' : ''}}" data-period="calendar" bindtap="onPeriod">日历</view></view>
  <view wx:if="{{summary}}">
    <view class="report-caption">{{summary.start}}　—　{{summary.end}}</view>
    <view wx:if="{{loadError}}" class="stale-notice">暂时无法更新，当前显示上次统计。</view>
    <view class="summary-grid"><view class="summary-tile"><view class="summary-figure">{{summary.exercise_count}}</view><view class="summary-label">运动次数</view><view class="summary-foot">{{summary.exercise_minutes}} 分钟累计</view></view><view class="summary-tile"><view class="summary-figure">{{sleepLabel}}<text class="figure-unit">h</text></view><view class="summary-label">平均睡眠</view><view class="summary-foot">按已记录日期计算</view></view><view class="summary-tile summary-wide"><view><view class="summary-figure">{{summary.habit_completion}}<text class="figure-unit">%</text></view><view class="summary-label">习惯记录覆盖</view></view><view class="habit-meter"><view class="habit-meter-fill" style="width: {{summary.habit_completion}}%;"></view></view></view></view>
    <view wx:if="{{period === 'calendar'}}" class="card calendar-card"><view class="calendar-head"><view class="section-title">{{calendarLabel}}</view><view class="calendar-nav"><text bindtap="changeMonth" data-step="-1">‹</text><text bindtap="changeMonth" data-step="1">›</text></view></view><view class="calendar-grid"><text wx:for="{{weekLabels}}" wx:key="*this" class="calendar-weekday">{{item}}</text><view wx:for="{{calendarCells}}" wx:key="key" class="calendar-cell {{item.isToday ? 'calendar-today' : ''}} {{item.recordedClass ? 'calendar-recorded' : ''}} {{item.empty ? 'calendar-empty' : ''}}"><text>{{item.day}}</text><view wx:if="{{item.hasRecord}}" class="calendar-dot"></view></view></view><view class="calendar-legend"><view class="legend-dot"></view><text>有记录</text><text class="muted">{{summary.days.length}} 天有记录</text></view></view>
    <view wx:else class="card trend-report"><view class="trend-report-head"><view><view class="section-title">身体趋势</view><view class="muted">每天单独呈现，避免把缺失数据当成变化</view></view><view class="trend-legend"><view class="legend-weight"></view>体重</view></view>
      <view wx:for="{{charts}}" wx:key="field" class="line-chart {{item.field === 'waist_cm' ? 'waist-chart' : ''}}">
        <view class="chart-heading"><view class="chart-name">{{item.field === 'weight' ? '体重' : '腰围'}} <text>{{item.unit}}</text></view><view class="chart-range">{{item.min}} — {{item.max}} {{item.unit}}</view></view>
        <view class="plot">
          <view class="gridline gridline-top"></view><view class="gridline gridline-middle"></view><view class="gridline gridline-bottom"></view>
          <text class="axis-label axis-high">{{item.max}}</text><text class="axis-label axis-low">{{item.min}}</text>
          <view wx:for="{{item.segments}}" wx:for-item="segment" wx:key="key" class="chart-segment" style="left: {{segment.x}}rpx; top: {{segment.y}}rpx; width: {{segment.length}}rpx; transform: rotate({{segment.angle}}deg);"></view>
          <view wx:for="{{item.points}}" wx:for-item="point" wx:key="key" class="chart-point" style="left: {{point.x}}rpx; top: {{point.y}}rpx;"><view class="point-tooltip">{{point.text}}</view></view>
        </view>
        <view class="date-axis"><text wx:for="{{item.labels}}" wx:key="key" style="left: {{item.x}}rpx;">{{item.text}}</text></view>
      </view>
      <view wx:if="{{summary.days.length}}" class="trend-list"><view wx:for="{{trendRows}}" wx:key="record_date" class="trend-row"><view class="trend-date">{{item.short_date}}</view><view class="trend-track"><view class="trend-weight-bar" style="width: {{item.weight_width}}%;"></view></view><view class="trend-value">{{item.weight_label}}</view><view class="waist-value">{{item.waist_label}}</view></view></view>
      <view wx:else class="empty">本周期还没有身体数据。开始记录后，这里会展示变化。</view>
    </view>
    <view class="health-note">这里只汇总你录入的数据，不用于疾病诊断。</view>
  </view><view wx:elif="{{loadError}}" class="error-state"><view class="section-title">暂时无法读取统计</view><view class="muted">{{loadError}}</view><button class="button" bindtap="retryLoad">重新加载</button></view><view wx:else class="loading-state"><view class="loading-orbit"><view class="loading-spark"></view></view><view class="loading-copy">正在整理你的变化</view><view class="loading-caption">WELLTRACK · 正在同步</view></view>
</view>
