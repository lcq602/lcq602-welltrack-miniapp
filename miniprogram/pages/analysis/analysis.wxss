/* ==========================================================================
   WellTrack 分析页面样式 (Stitch "Serene Balance" 趋势与数据复盘)
   ========================================================================== */

/* 周期切换分段器 */
.period-switch-bar {
  display: flex;
  background: #eef2f6;
  padding: 8rpx;
  border-radius: 9999rpx;
  margin-bottom: 24rpx;
}

.period-pill {
  flex: 1;
  height: 68rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #64748b;
  transition: all 0.2s ease;
}

.period-pill-active {
  background: #ffffff;
  color: #0f172a;
  font-weight: 750;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.08);
}

/* 日期范围标签 */
.report-range-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.report-range-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #475569;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 9999rpx;
  padding: 8rpx 22rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.02);
}

.range-calendar-icon {
  font-size: 22rpx;
}

/* 摘要 Bento 网格 */
.summary-bento-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.summary-tile {
  margin-bottom: 0;
  padding: 26rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.summary-tile-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.summary-tile-label {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 600;
}

.summary-icon-squircle {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.icon-blue {
  background: #eff6ff;
  border: 1rpx solid rgba(37, 99, 235, 0.15);
}

.icon-purple {
  background: #f5f3ff;
  border: 1rpx solid rgba(124, 58, 237, 0.15);
}

.icon-emerald {
  background: #ecfdf5;
  border: 1rpx solid rgba(5, 150, 105, 0.15);
}

.icon-amber {
  background: #fffbeb;
  border: 1rpx solid rgba(217, 119, 6, 0.15);
}

.tile-emerald-glow {
  background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%);
  border: 1rpx solid rgba(5, 150, 105, 0.15);
}

.tile-amber-glow {
  background: linear-gradient(135deg, #fffbeb 0%, #ffffff 100%);
  border: 1rpx solid rgba(217, 119, 6, 0.15);
}

.tile-purple-glow {
  background: linear-gradient(135deg, #faf5ff 0%, #ffffff 100%);
  border: 1rpx solid rgba(147, 51, 234, 0.15);
}

.tile-blue-glow {
  background: linear-gradient(135deg, #eff6ff 0%, #ffffff 100%);
  border: 1rpx solid rgba(37, 99, 235, 0.15);
}

.summary-tile-val {
  font-size: 44rpx;
  font-weight: 800;
  color: #0f172a;
  margin: 14rpx 0 4rpx;
  line-height: 1.1;
  font-feature-settings: "tnum";
}

.val-unit {
  font-size: 22rpx;
  font-weight: 500;
  color: #94a3b8;
  margin-left: 4rpx;
}

.summary-tile-foot {
  font-size: 20rpx;
  color: #94a3b8;
}

.summary-tile-wide {
  grid-column: span 2;
  padding: 28rpx;
}

.wide-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.habit-meter-track {
  height: 12rpx;
  background: #f1f5f9;
  border-radius: 9999rpx;
  overflow: hidden;
}

.habit-meter-fill {
  height: 100%;
  background: linear-gradient(90deg, #10b981 0%, #059669 100%);
  border-radius: 9999rpx;
  transition: width 0.4s ease;
}

/* 日历卡片 */
.calendar-card {
  padding: 32rpx;
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.calendar-nav-group {
  display: flex;
  gap: 16rpx;
}

.calendar-nav-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f5f9;
  color: #334155;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.calendar-nav-btn:active {
  background: #e2e8f0;
}

.calendar-week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  margin-bottom: 12rpx;
}

.calendar-weekday {
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 600;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.calendar-cell {
  height: 74rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  font-size: 24rpx;
  font-weight: 600;
  color: #334155;
}

.cell-empty {
  visibility: hidden;
}

.cell-recorded {
  background: #ecfdf5;
  color: #059669;
  font-weight: 700;
}

.cell-today {
  background: #059669 !important;
  color: #ffffff !important;
  font-weight: 800;
  box-shadow: 0 4rpx 14rpx rgba(5, 150, 105, 0.3);
}

.cell-record-dot {
  position: absolute;
  bottom: 8rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #059669;
}

.calendar-legend-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f1f5f9;
  font-size: 22rpx;
  color: #64748b;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.dot-emerald {
  background: #059669;
}

.dot-today {
  background: #059669;
  box-shadow: 0 0 0 3rpx #a7f3d0;
}

.legend-summary {
  margin-left: auto;
  color: #94a3b8;
}

/* 趋势图表卡片 */
.trend-card {
  padding: 32rpx;
}

/* 图表维度切换 Tab */
.chart-tab-bar {
  display: flex;
  background: #f1f5f9;
  border-radius: 9999rpx;
  padding: 6rpx;
  margin-bottom: 28rpx;
  gap: 6rpx;
}

.chart-tab-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #64748b;
  transition: all 0.2s ease;
}

.chart-tab-item.tab-active {
  background: #ffffff;
  color: #0f172a;
  font-weight: 750;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

.trend-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.trend-legends {
  display: flex;
  gap: 16rpx;
}

.legend-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.dot-purple {
  background: #7c3aed;
}

/* 步数 / 卡路里柱状波动图容器 */
.bar-chart-container {
  position: relative;
  padding: 36rpx 10rpx 16rpx;
  margin: 10rpx 0 20rpx;
  height: 280rpx;
  box-sizing: border-box;
}

.bar-target-line {
  position: absolute;
  left: 0;
  right: 0;
  top: 100rpx;
  border-top: 2rpx dashed rgba(5, 150, 105, 0.4);
  z-index: 1;
}

.bar-target-label {
  position: absolute;
  right: 12rpx;
  top: 72rpx;
  font-size: 18rpx;
  color: #059669;
  font-weight: 600;
  background: #f0fdf4;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  z-index: 2;
}

.bar-columns-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 100%;
}

.bar-col-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  max-width: 84rpx;
  height: 100%;
  justify-content: flex-end;
}

.bar-val-label {
  font-size: 18rpx;
  font-weight: 600;
  color: #94a3b8;
  margin-bottom: 8rpx;
  line-height: 1;
}

.val-achieved {
  color: #059669;
  font-weight: 750;
}

.val-amber {
  color: #d97706;
  font-weight: 750;
}

.bar-track-wrap {
  width: 32rpx;
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: #f8fafc;
  border-radius: 9999rpx;
  overflow: hidden;
}

.bar-pillar {
  width: 100%;
  border-radius: 9999rpx;
  transition: height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.pillar-emerald {
  background: linear-gradient(180deg, #10b981 0%, #059669 100%);
  box-shadow: 0 2rpx 8rpx rgba(16, 185, 129, 0.3);
}

.pillar-slate {
  background: #cbd5e1;
}

.pillar-amber {
  background: linear-gradient(180deg, #f59e0b 0%, #d97706 100%);
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.3);
}

.bar-date-label {
  font-size: 20rpx;
  color: #64748b;
  font-weight: 550;
  margin-top: 10rpx;
}

/* 睡眠与运动对照条形列表 */
.vitality-compare-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.vitality-compare-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #eef2f6;
}

.v-comp-date {
  font-size: 22rpx;
  font-weight: 650;
  color: #475569;
  width: 80rpx;
  flex-shrink: 0;
}

.v-comp-bars {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.v-comp-bar-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.v-bar-track {
  flex: 1;
  height: 12rpx;
  background: #e2e8f0;
  border-radius: 9999rpx;
  overflow: hidden;
}

.v-bar-fill {
  height: 100%;
  border-radius: 9999rpx;
  transition: width 0.3s ease;
}

.fill-purple {
  background: #8b5cf6;
}

.fill-blue {
  background: #3b82f6;
}

.v-bar-num {
  font-size: 20rpx;
  font-weight: 600;
  color: #64748b;
  width: 70rpx;
  text-align: right;
}

.line-chart-box {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
}

.chart-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.chart-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.chart-unit {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: 500;
  margin-left: 4rpx;
}

.chart-range-badge {
  font-size: 20rpx;
  color: #64748b;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 9999rpx;
  padding: 2rpx 14rpx;
}

.plot-canvas {
  position: relative;
  height: 180rpx;
  margin: 16rpx 20rpx 0 76rpx;
}

.plot-gridline {
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background: #f1f5f9;
}

.gridline-top {
  top: 18rpx;
}

.gridline-mid {
  top: 84rpx;
  border-top: 1.5rpx dashed #e2e8f0;
  background: transparent;
}

.gridline-bot {
  top: 150rpx;
}

.axis-lbl {
  position: absolute;
  left: -72rpx;
  width: 60rpx;
  text-align: right;
  font-size: 18rpx;
  color: #94a3b8;
  font-weight: 500;
}

.lbl-top {
  top: 8rpx;
}

.lbl-bot {
  top: 140rpx;
}

.chart-segment {
  position: absolute;
  height: 4rpx;
  border-radius: 4rpx;
  transform-origin: 0 50%;
  z-index: 1;
}

.chart-point {
  position: absolute;
  z-index: 2;
  width: 14rpx;
  height: 14rpx;
  margin: -7rpx 0 0 -7rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
}

.chart-weight .chart-segment {
  background: #059669;
}

.chart-weight .chart-point {
  background: #059669;
  box-shadow: 0 0 0 2rpx #059669;
}

.chart-waist .chart-segment {
  background: #7c3aed;
}

.chart-waist .chart-point {
  background: #7c3aed;
  box-shadow: 0 0 0 2rpx #7c3aed;
}

.x-axis-row {
  position: relative;
  height: 32rpx;
  margin-left: 76rpx;
  margin-top: 8rpx;
}

.x-label {
  position: absolute;
  transform: translateX(-50%);
  font-size: 18rpx;
  color: #94a3b8;
  white-space: nowrap;
}

.trend-detail-list {
  margin-top: 28rpx;
  border-top: 1rpx solid #f1f5f9;
  padding-top: 10rpx;
}

.trend-detail-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f8fafc;
  gap: 14rpx;
}

.row-date {
  width: 76rpx;
  font-size: 22rpx;
  color: #64748b;
  font-weight: 600;
}

.row-bar-track {
  flex: 1;
  height: 14rpx;
  background: #f1f5f9;
  border-radius: 9999rpx;
  overflow: hidden;
}

.row-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #10b981 0%, #059669 100%);
  border-radius: 9999rpx;
}

.row-weight-val {
  width: 110rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 700;
  color: #0f172a;
}

.row-waist-val {
  width: 130rpx;
  text-align: right;
  font-size: 22rpx;
  color: #64748b;
}
