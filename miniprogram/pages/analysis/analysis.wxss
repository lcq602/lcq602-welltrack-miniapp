.chart { display: flex; align-items: flex-end; justify-content: space-around; height: 200rpx; margin: 24rpx 0 12rpx; }.bar-wrap { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; min-width: 58rpx; }.bar { width: 26rpx; border-radius: 10rpx 10rpx 2rpx 2rpx; background: #80ae8b; }.tiny { font-size: 18rpx; color: #718077; }.history { padding: 12rpx 0; font-size: 22rpx; }
