/* ==========================================================================
   WellTrack 轻衡健康 - 全局样式表 (Stitch "Serene Balance" 设计系统)
   ========================================================================== */

page {
  background-color: #f6f8fb;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "Plus Jakarta Sans", "SF Pro Display", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

/* 主页面容器 */
.page {
  padding: 24rpx 32rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  min-height: 100vh;
}

/* 页面顶部区域 */
.page-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.brand-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  font-weight: 650;
  color: #059669;
  letter-spacing: 1.5rpx;
  background: rgba(5, 150, 105, 0.08);
  padding: 8rpx 18rpx;
  border-radius: 9999rpx;
  border: 1rpx solid rgba(5, 150, 105, 0.16);
  margin-bottom: 12rpx;
}

.pulse-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #059669;
  box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.7);
  animation: pulse-green 2s infinite;
}

@keyframes pulse-green {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.7); }
  70% { transform: scale(1); box-shadow: 0 0 0 8rpx rgba(5, 150, 105, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(5, 150, 105, 0); }
}

.page-title {
  color: #0f172a;
  font-size: 44rpx;
  font-weight: 750;
  letter-spacing: -0.5rpx;
  line-height: 1.25;
}

.page-subtitle {
  color: #64748b;
  font-size: 24rpx;
  margin-top: 6rpx;
  line-height: 1.5;
}

/* 纯白 Bento 卡片 */
.card, .bento-card {
  background: #ffffff;
  border-radius: 36rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.85);
  box-shadow: 0 10rpx 36rpx -6rpx rgba(15, 23, 42, 0.04), 0 2rpx 8rpx 0 rgba(15, 23, 42, 0.02);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  position: relative;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-kicker {
  font-size: 20rpx;
  font-weight: 700;
  color: #64748b;
  letter-spacing: 1.5rpx;
  text-transform: uppercase;
}

.card-title {
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 700;
}

.card-subtitle {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 4rpx;
}

/* 彻底清除微信小程序原生 button 预设样式与伪元素灰色边框 */
button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0 32rpx;
  width: 100%;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  outline: none;
  background-color: transparent;
  line-height: normal;
  border-radius: 9999rpx;
  -webkit-tap-highlight-color: transparent;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

button::after {
  display: none !important;
  content: none !important;
  border: none !important;
}

/* 按钮规范 */
.btn-primary, .button {
  background: linear-gradient(135deg, #059669 0%, #00855d 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 650;
  border-radius: 9999rpx;
  min-height: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 20rpx rgba(5, 150, 105, 0.25);
  border: none;
  box-sizing: border-box;
}

.btn-primary:active, .button:active {
  transform: scale(0.982);
  opacity: 0.92;
  box-shadow: 0 4rpx 12rpx rgba(5, 150, 105, 0.2);
}

.btn-primary[disabled], .button[disabled] {
  background: #cbd5e1 !important;
  color: #94a3b8 !important;
  box-shadow: none !important;
  opacity: 0.8;
  transform: none !important;
}

.btn-secondary, .button-light {
  background: #ffffff;
  color: #334155;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 9999rpx;
  min-height: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 1.5rpx solid #e2e8f0;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  box-sizing: border-box;
}

.btn-secondary:active, .button-light:active {
  background: #f8fafc;
  transform: scale(0.982);
}

.btn-quiet, .button-quiet {
  background: transparent;
  color: #64748b;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 9999rpx;
  font-size: 26rpx;
  font-weight: 550;
  min-height: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}

.btn-row > button, .btn-row > navigator {
  width: 100% !important;
  min-height: 88rpx;
  height: 88rpx;
  box-sizing: border-box;
}

/* 标签与胶囊 */
.pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
  box-sizing: border-box;
}

.pill-emerald {
  background: #ecfdf5;
  color: #059669;
  border: 1rpx solid rgba(5, 150, 105, 0.2);
}

.pill-blue {
  background: #eff6ff;
  color: #2563eb;
  border: 1rpx solid rgba(37, 99, 235, 0.2);
}

.pill-amber {
  background: #fef3c7;
  color: #d97706;
  border: 1rpx solid rgba(217, 119, 6, 0.2);
}

.pill-purple {
  background: #f5f3ff;
  color: #7c3aed;
  border: 1rpx solid rgba(124, 58, 237, 0.2);
}

.pill-slate {
  background: #f1f5f9;
  color: #475569;
  border: 1rpx solid #e2e8f0;
}

/* 输入表单与选择器 */
.form-input, .input {
  background: #f8fafc;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #0f172a;
  box-sizing: border-box;
  width: 100%;
  min-height: 84rpx;
}

.form-input:focus, .input:focus {
  background: #ffffff;
  border-color: #059669;
}

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f8fafc;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #0f172a;
  box-sizing: border-box;
  width: 100%;
}

.field-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  margin: 20rpx 0 8rpx;
}

/* 提示文案与说明 */
.muted {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
}

.footnote-note, .append-note {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 14rpx;
  line-height: 1.5;
  text-align: center;
}

/* 排版数值 */
.number-display {
  font-size: 64rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -1.5rpx;
  line-height: 1.1;
}

.number-display .unit {
  font-size: 24rpx;
  font-weight: 500;
  color: #64748b;
  margin-left: 6rpx;
}

/* 加载中与错误状态 */
.loading-state, .error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.loading-spinner {
  width: 72rpx;
  height: 72rpx;
  border: 6rpx solid #e2e8f0;
  border-top-color: #059669;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.loading-sub {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.error-mark {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fef2f2;
  color: #ef4444;
  font-size: 38rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

/* 通用空状态 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 30rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.6;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  font-size: 36rpx;
  margin-bottom: 16rpx;
}
